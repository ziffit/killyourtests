{
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--config=./playwright-mcp.config.json",
          "--user-data-dir=/tmp/pw-mcp-profile",
          "--grant-permissions=notifications,geolocation,clipboard-read,clipboard-write"
        ]
      }
    }
  }
}